<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ytmp3" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent2</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorControlActivated">@color/accent</item>
    </style>

    <style name="Widget.Ytmp3.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Ytmp3.Button.Ghost" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
